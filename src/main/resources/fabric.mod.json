{
  "schemaVersion": 1,
  "id": "muto_menu",
  "version": "${version}",
  "name": "Muto Menu",
  "description": "Native ModMenu integration for Muto Runtime. Manage, toggle, filter, and hot-reload mods directly inside ModMenu.",
  "authors": [
    "fy2ne"
  ],
  "contact": {
    "homepage": "https://muto.fy2ne.me/menu",
    "sources": "https://github.com/fy2ne/muto-menu",
    "issues": "https://github.com/fy2ne/muto-menu/issues"
  },
  "license": "Apache-2.0",
  "icon": "assets/muto_menu/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "me.fy2ne.muto.menu.MenuMod"
    ],
    "modmenu": [
      "me.fy2ne.muto.menu.plugin.MutoModMenuPlugin"
    ]
  },
  "mixins": [
    "muto-menu.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": ">=0.144.1",
    "minecraft": ">=26.1 <27.0",
    "java": ">=25",
    "muto": ">=0.3.0-beta",
    "modmenu": "*"
  }
}
