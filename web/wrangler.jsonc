{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muto-menu",
  "main": "./worker.js",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "mutomenu.fy2ne.me",
      "custom_domain": true
    }
  ]
}
